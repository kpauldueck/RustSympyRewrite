{
 "sympy_version": "1.14.0",
 "topic": "units",
 "cases": [
  {
   "op": "parse_expr",
   "args": [
    "12 m/s"
   ],
   "options": {
    "local_dict": "sympy.physics.units",
    "transformations": [
     "lambda_notation",
     "auto_symbol",
     "repeated_decimals",
     "auto_number",
     "factorial_notation",
     "implicit_multiplication",
     "convert_xor"
    ]
   },
   "expected": "12*meter/second",
   "expected_latex": "\\frac{12 \\text{m}}{\\text{s}}",
   "compare": "exact",
   "source": "sympy",
   "note": "m and s are meter and second in the units namespace, not plain Symbols.",
   "id": "units-000"
  },
  {
