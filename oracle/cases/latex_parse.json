{
 "sympy_version": "1.14.0",
 "topic": "latex_parse",
 "cases": [
  {
   "op": "parse_latex",
   "args": [
    "\\Delta x"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "UnexpectedCharacters",
   "compare": "error",
   "source": "sympy",
   "note": "The Lark grammar knows \\delta but has no \\Delta.",
   "id": "latex_parse-000"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\frac{\\Delta y}{\\Delta x}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "UnexpectedCharacters",
   "compare": "error",
   "source": "sympy",
   "note": "The unknown \\Delta sits inside a fraction.",
   "id": "latex_parse-001"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\Delta x^{2}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "UnexpectedCharacters",
   "compare": "error",
   "source": "sympy",
   "note": "The Lark grammar has no \\Delta command.",
   "id": "latex_parse-002"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\Delta v_{x}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "UnexpectedCharacters",
   "compare": "error",
   "source": "sympy",
   "note": "The Lark grammar has no \\Delta command.",
   "id": "latex_parse-003"
  },
  {
   "op": "parse_latex",
   "args": [
    "F\\Delta t = m\\Delta v"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "UnexpectedCharacters",
   "compare": "error",
   "source": "sympy",
   "note": "The unknown \\Delta follows an implicit product, in an equation.",
   "id": "latex_parse-004"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\frac{dy}{dx}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "(derivative, x)",
   "compare": "exact",
   "source": "sympy",
   "note": "A bare Leibniz fraction returns the Python tuple ('derivative', x), not a SymPy object.",
   "id": "latex_parse-005"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\frac{d}{dx}x^{2}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "Derivative(x**2, x)",
   "expected_latex": "\\frac{d}{d x} x^{2}",
   "compare": "exact",
   "source": "sympy",
   "note": "d/dx in front of an expression builds an unevaluated Derivative.",
   "id": "latex_parse-006"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\frac{d^{2}y}{dx^{2}}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "UnexpectedCharacters",
   "compare": "error",
   "source": "sympy",
   "note": "Fails at the y after d^{2}: a power cannot be followed by a letter, so the input never reaches the fraction.",
   "id": "latex_parse-007"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\frac{d}{t}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "d/t",
   "expected_latex": "\\frac{d}{t}",
   "compare": "exact",
   "source": "sympy",
   "note": "The denominator t does not start with d, so the numerator is the plain Symbol d and the result is the quotient d/t. Only a denominator of d followed by an implicit-product factor gives the ('derivative', factor) tuple, whatever the numerator.",
   "id": "latex_parse-008"
  },
  {
   "op": "parse_latex",
   "args": [
    "\\overline{AB}"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "conjugate(A)*conjugate(B)",
   "expected_latex": "\\overline{A} \\overline{B}",
   "compare": "exact",
   "source": "sympy",
   "note": "\\overline is complex conjugation, applied to the product A*B.",
   "id": "latex_parse-009"
  },
  {
   "op": "parse_latex",
   "args": [
    "AB"
   ],
   "options": {
    "backend": "lark"
   },
   "expected": "A*B",
   "expected_latex": "A B",
   "compare": "exact",
   "source": "sympy",
   "note": "A run of capital letters is an implicit product of symbols.",
   "id": "latex_parse-010"
  },
  {
   "op": "parse_latex",
   "args": [
    "AB^{2} + BC^{2} = AC^{2}"
   ],
   "options": {
    "backend": "lark"
   },
