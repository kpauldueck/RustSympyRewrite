{
 "sympy_version": "1.14.0",
 "topic": "printing",
 "cases": [
  {
   "op": "sympify",
   "args": [
    "x**2/2 + 3*x - 1"
   ],
   "expected": "x**2/2 + 3*x - 1",
   "expected_latex": "\\frac{x^{2}}{2} + 3 x - 1",
   "compare": "exact",
   "source": "sympy",
   "id": "printing-000"
  },
  {
   "op": "sympify",
   "args": [
    "sqrt(x)/(x + 1)"
   ],
   "expected": "sqrt(x)/(x + 1)",
   "expected_latex": "\\frac{\\sqrt{x}}{x + 1}",
   "compare": "exact",
   "source": "sympy",
   "id": "printing-001"
  },
  {
   "op": "sympify",
   "args": [
    "sin(x)**2"
   ],
   "expected": "sin(x)**2",
   "expected_latex": "\\sin^{2}{\\left(x \\right)}",
   "compare": "exact",
   "source": "sympy",
   "id": "printing-002"
  },
  {
   "op": "sympify",
   "args": [
    "-3*x*y/4"
   ],
   "expected": "-3*x*y/4",
   "expected_latex": "- \\frac{3 x y}{4}",
   "compare": "exact",
   "source": "sympy",
   "id": "printing-003"
  },
  {
   "op": "sympify",
   "args": [
    "exp(-x)*log(x)"
   ],
   "expected": "exp(-x)*log(x)",
   "expected_latex": "e^{- x} \\log{\\left(x \\right)}",
   "compare": "exact",
   "source": "sympy",
   "id": "printing-004"
  },
  {
   "op": "sympify",
   "args": [
    "Interval.Ropen(0, 1)"
   ],
   "expected": "Interval.Ropen(0, 1)",
   "expected_latex": "\\left[0, 1\\right)",
   "compare": "exact",
   "source": "sympy",
   "id": "printing-005"
  },
  {
   "op": "parse_expr",
   "args": [
    "x^2 + 2x + 1"
   ],
   "options": {
    "transformations": [
     "lambda_notation",
     "auto_symbol",
     "repeated_decimals",
     "auto_number",
     "factorial_notation",
     "implicit_multiplication_application",
     "convert_xor"
    ]
   },
   "expected": "x**2 + 2*x + 1",
   "expected_latex": "x^{2} + 2 x + 1",
   "compare": "exact",
   "source": "sympy",
   "note": "convert_xor reads ^ as a power, and implicit multiplication reads 2x as 2*x.",
   "id": "printing-006"
  },
  {
   "op": "parse_expr",
   "args": [
    "3(x - 1)"
   ],
   "options": {
    "transformations": [
     "lambda_notation",
     "auto_symbol",
     "repeated_decimals",
     "auto_number",
     "factorial_notation",
     "implicit_multiplication_application",
     "convert_xor"
    ]
   },
   "expected": "3*x - 3",
   "expected_latex": "3 x - 3",
   "compare": "exact",
   "source": "sympy",
   "note": "Implicit multiplication reads 3(x - 1) as 3*(x - 1). SymPy then distributes the number over the sum.",
   "id": "printing-007"
  },
  {
   "op": "parse_expr",
   "args": [
    "sin x + cos(2x)"
   ],
   "options": {
    "transformations": [
     "lambda_notation",
     "auto_symbol",
     "repeated_decimals",
     "auto_number",
     "factorial_notation",
     "implicit_multiplication_application",
     "convert_xor"
    ]
   },
   "expected": "sin(x) + cos(2*x)",
   "expected_latex": "\\sin{\\left(x \\right)} + \\cos{\\left(2 x \\right)}",
   "compare": "exact",
   "source": "sympy",
   "note": "Implicit application reads sin x as sin(x).",
   "id": "printing-008"
  },
  {
   "op": "parse_expr",
   "args": [
    "2^10"
   ],
   "options": {
    "transformations": [
     "lambda_notation",
     "auto_symbol",
     "repeated_decimals",
     "auto_number",
     "factorial_notation",
     "implicit_multiplication_application",
     "convert_xor"
    ]
   },
   "expected": "1024",
   "expected_latex": "1024",
   "compare": "exact",
   "source": "sympy",
   "note": "Without convert_xor, ^ is Python's XOR and 2^10 gives 8.",
   "id": "printing-009"
  },
  {
   "op": "parse_expr",
   "args": [
    "sqrt(16)x"
   ],
   "options": {
    "transformations": [
     "lambda_notation",
     "auto_symbol",
     "repeated_decimals",
     "auto_number",
     "factorial_notation",
     "implicit_multiplication_application",
     "convert_xor"
    ]
   },
   "expected": "4*x",
   "expected_latex": "4 x",
   "compare": "exact",
   "source": "sympy",
   "note": "Implicit multiplication after a function call. sqrt(16) evaluates to 4.",
   "id": "printing-010"
  }
 ]
}
